rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // E-postası doğrulanmış giriş yapmış kullanıcı (içerik oluşturma için şart).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function noPublicEmailOnCreate() {
      return !request.resource.data.keys().hasAny(['email']);
    }

    function emailNotChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']);
    }

    // İki katılımcı arasında (her iki yönde) engel var mı?
    function blockedForPair(parts) {
      return exists(/databases/$(database)/documents/blocks/$(parts[0] + '_' + parts[1]))
        || exists(/databases/$(database)/documents/blocks/$(parts[1] + '_' + parts[0]));
    }

    // Sayaç bütünlüğü: bir alan yazıldıysa yalnızca ±1 değişebilir (keyfi değere set edilemez).
    function counterStep(f) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([f])
        || request.resource.data[f] == resource.data.get(f, 0) + 1
        || request.resource.data[f] == resource.data.get(f, 0) - 1;
    }
    // users: yalnızca takip sayaçları değişti ve her biri ±1 mi?
    function followerCountersOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount'])
        && counterStep('followersCount') && counterStep('followingCount');
    }
    function noCounterChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingCount']);
    }
    // posts: yalnızca pariltiCount değişti ve ±1 mi?
    function pariltiOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pariltiCount'])
        && counterStep('pariltiCount');
    }
    // posts: sahibi yalnızca archived/archivedAt alanlarını mı değiştiriyor?
    function archiveOnlyUpdate() {
      return resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archivedAt']);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && noPublicEmailOnCreate();
      // Kendi profilini düzenler (email + sayaçlar HARİÇ); ya da herhangi biri
      // yalnızca takip sayaçlarını ±1 değiştirebilir (takip/çık akışı için).
      allow update: if (isSelf(uid) && emailNotChanged() && noCounterChange())
        || (verified() && followerCountersOnly());
      allow delete: if isSelf(uid);
    }

    match /userPrivate/{uid} {
      allow read, create, update, delete: if isSelf(uid);
    }

    match /usernames/{username} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && !request.resource.data.keys().hasAny(['email'])
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if verified() && request.resource.data.authorUid == request.auth.uid;
      // Doğrulanmış kullanıcı pariltiCount'u ±1 değiştirebilir (parlat/geri al);
      // ayrıca sahibi anısını arşivleyebilir/geri alabilir (archived/archivedAt).
      allow update: if verified() && (pariltiOnlyUpdate() || archiveOnlyUpdate());
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow create, update: if verified() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /reactions/{reactionId} {
      allow read: if signedIn();
      allow create, update: if verified() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /saves/{saveId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      // Takip isteğini yalnızca DOĞRULANMIŞ takip eden oluşturur (başkası adına uydurulamaz).
      allow create: if verified() && request.resource.data.followerUid == request.auth.uid;
      // Onay/geri çekme: taraflardan biri güncelleyebilir (gizli hesap onayı vb.).
      allow update, delete: if signedIn()
        && (resource.data.followerUid == request.auth.uid
          || resource.data.followedUid == request.auth.uid);
    }

    // Engelleme: yalnızca engelleyen kendi kaydını görür/oluşturur/siler.
    // (Karşı taraf da kendini engelleyen kaydı okuyabilsin ki DM engeli çalışsın.)
    match /blocks/{blockId} {
      allow read: if signedIn()
        && (resource.data.blockerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid != request.auth.uid;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // Şikayet: kullanıcı yalnızca kendi adına oluşturur; okuma/silme sadece admin (console).
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create, update: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if verified()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && !blockedForPair(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
        allow update, delete: if false;
      }
    }
  }
}
