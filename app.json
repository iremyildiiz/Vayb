{
  "expo": {
    "name": "Vayb",
    "slug": "vayb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/vayb-icon-clean.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iremyildiz.vaybapp",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF7A5C",
        "foregroundImage": "./assets/vayb-icon-clean.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/vayb-icon-clean.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/vayb-splash-mark-transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF7A5C",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/vayb-splash-mark-transparent.png",
            "backgroundColor": "#FF7A5C"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vayb, paylaşmak istediğin fotoğrafı seçebilmen için galerine erişir.",
          "cameraPermission": "Vayb, anlık bir kare çekebilmen için kameraya erişir."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Vayb, galerindeki kareleri uygulama içinde gösterip paylaşabilmen için erişir.",
          "savePhotosPermission": "Vayb, çektiğin kareleri galerine kaydedebilmek için erişir."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4afaf5cc-db84-4402-8a42-172cbf5b960e"
      }
    }
  }
}
